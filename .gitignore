# macOS
.DS_Store
._*

# Editor / tooling
.vscode/
.idea/
*.swp

# Logs / temp
*.log
node_modules/

# Asset-gen intermediates: the large chroma-key/source PNGs fed to the
# post-process scripts. Reproducibility lives in the prompts + scripts + the
# chosen finals under assets/; the bulky sources stay local (see docs/ART_PLAN.md).
tools/gen/source_batch*/
# Raw codex character albedos for the player body (skin/coat/trouser candidates +
# contact sheet); the chosen finals ship under assets/textures/player/.
tools/gen/source_body/
# Post-process scratch dirs (alpha/seam/contact checks) — regenerated by the scripts.
tools/gen/.tmp_*/
# Transient batch watchers (orchestrator-local progress pollers).
tools/gen/watch_batch*

# Local-only design source (kept out of the public game repo)
City_of_Small_Chances_Game_Design_Book.md
.claude/

# Transient Chromium headless logs (written to CWD when probing from the repo root).
logs/
